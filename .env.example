# Copy to .env and fill in. Real environment variables override this file.

# --- Who gets the summary -------------------------------------------------
# Team phone number(s) that receive the group summary SMS (E.164, comma separated).
TEAM_PHONE_NUMBER=+15551234567
# team | callers | both   (default: team if TEAM_PHONE_NUMBER is set, else callers)
SUMMARY_RECIPIENTS=team

# --- Phone number people call ---------------------------------------------
# The Twilio number attendees dial. Defaults to TWILIO_PHONE_NUMBER. Shown in the
# startup output and on the dashboard. `pnpm phone:setup` points it at this app.
AGENT_PHONE_NUMBER=

# --- SMS sender (Twilio) --------------------------------------------------
# TWILIO_PHONE_NUMBER is the number the SMS come FROM (must be an SMS-capable
# Twilio number; can be the same number people call). Without all three values
# the app runs in dry-run mode: summaries are logged and shown, not sent.
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN live in .env.local (gitignored, server-side only)
# Your Twilio number (also accepted as TWILIO_FROM_NUMBER). Put it in .env.local next to the keys.
TWILIO_PHONE_NUMBER=

# --- Behaviour ------------------------------------------------------------
AUTO_SEND_DELAY_SECONDS=120
TIMEZONE=America/New_York
# Seconds of silence that end a spoken answer (higher = more patient with rambling)
SPEECH_TIMEOUT_SECONDS=3
# Public https URL of this app (required for phone:setup; also enables Twilio signature validation)
PUBLIC_BASE_URL=
# Optional: pre-link numbers to names  (+15551230001=Alice,+15551230002=Bob)
KNOWN_PEOPLE=

# --- Telegram (optional) --------------------------------------------------
# Real values go in .env.local. Create a bot with @BotFather, add it to your
# channel as an admin, and use the channel id (-100...) or @channelname.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
